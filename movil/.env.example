# Copia este archivo como `.env` y pega tus credenciales de Supabase.
#
# Están en el panel de Supabase, en Settings → API.
#
# El prefijo EXPO_PUBLIC_ hace que Expo las incluya en la aplicación. Eso está
# bien para estas dos: la llave anónima es pública por diseño, y lo que protege
# los datos son las políticas de seguridad por fila del esquema.
#
# NUNCA pongas aquí la llave `service_role`: omite todas las políticas y
# cualquiera podría extraerla del binario.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-llave-anonima
